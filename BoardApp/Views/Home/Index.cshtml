@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to the Board App</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<hr />

<div class="container">
    <h3>Available Boards</h3>
    <ul class="list-group">
        @foreach (var board in BoardApp.Models.Repository.Boards)
        {
            <li class="list-group-item">@board.ToString()</li>
        }
    </ul>
</div>
