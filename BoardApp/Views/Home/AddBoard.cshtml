@model BoardApp.Models.Board
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add a Board</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/styles.css" />
</head>
<body class="container mt-5">
    <h2>Add a New Board</h2>

    <form asp-action="AddBoard" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="BoardCode" class="form-label">Board Code</label>
            <input asp-for="BoardCode" class="form-control" />
            <span asp-validation-for="BoardCode" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Make" class="form-label">Manufacturer (Make)</label>
            <input asp-for="Make" class="form-control" />
            <span asp-validation-for="Make" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Model" class="form-label">Model Name</label>
            <input asp-for="Model" class="form-control" />
            <span asp-validation-for="Model" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="FlashKb" class="form-label">Flash Size (KB)</label>
            <input asp-for="FlashKb" class="form-control" />
            <span asp-validation-for="FlashKb" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label">Price (R)</label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Add Board</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</body>
</html>